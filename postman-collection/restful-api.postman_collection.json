              "",
              "const responseJson = pm.response.json();",
              "const requestBody = JSON.parse(pm.request.body.raw);",
              "",
              "pm.test(\"CT-API-007.2: 'id' do objeto permanece inalterado\", function () {",
              "    pm.expect(responseJson.id.toString()).to.eql(pm.environment.get(\"generatedId\"));",
              "});",
              "",
              "pm.test(\"CT-API-007.3: Todos os campos de 'data' refletem ao que foi enviado no request body\", function () {",
              "    pm.expect(responseJson.data).to.deep.equal(requestBody.data);",
              "});",
              "",
              "pm.test(\"CT-API-007.4: 'updatedAt' é maior do que o valor de 'createdAt' retornado no Body Response do métdo POST após criar o objeto\", function () {",
              "    const previousTimestamp = pm.environment.get(\"createdTime\");",
              "    pm.expect(responseJson.updatedAt).to.not.equal(previousTimestamp);",
              "    pm.expect(Number(responseJson.updatedAt)).to.be.greaterThan(Number(previousTimestamp));",
              "});",
