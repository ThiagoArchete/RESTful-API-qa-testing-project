    {
      "name": "Get All Objects - CT-API-001",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"CT-API-001.01: Status code é 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const responseJson = pm.response.json();\r",
              "\r",
              "pm.test(\"CT-API-001.02: Resposta deve ser array não vazio\", function () {\r",
              "        pm.expect(responseJson).to.be.an('array');\r",
              "        pm.expect(responseJson.length).to.be.above(0);\r",
              "});\r",
              "\r",
              "pm.test(\"CT-API-001.03: Cada objeto possui 'id' e 'name' como string\", function() {\r",
              "    responseJson.forEach(item => {\r",
              "        pm.expect(item).to.have.property(\"id\").that.is.a(\"string\");\r",
              "        pm.expect(item).to.have.property(\"name\").that.is.a(\"string\");\r",
              "    })\r",
              "});\r",
              "\r",
              "pm.test(\"CT-API-001.04: Cada objeto possui 'data' como objeto ou null\", function() {\r",
              "    responseJson.forEach(item => {\r",
              "        pm.expect(item).to.have.property(\"data\");\r",
              "        pm.expect(item.data === null || typeof item.data === \"object\").to.be.true;\r",
              "    });\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
